{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-metadata.schema.json",
  "title": "Portfolio document metadata",
  "type": "object",
  "required": ["tags", "createdate_show"],
  "properties": {
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdate_show": {
      "type": "string",
      "pattern": "^[0-9]{4}:[0-9]{2}:[0-9]{2}$"
    }
  },
  "additionalProperties": true
}
